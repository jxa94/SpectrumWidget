<Window x:Class="SpectrumWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpectrumWidget"
        Title="频谱音乐小部件"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" ShowActivated="False" Left="-10000" Top="-10000"
        FontFamily="{StaticResource UiFont}" Foreground="White"
        UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="22">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Grid x:Name="Card" Width="460">
            <!-- 底板 + 阴影 -->
            <Border x:Name="BackPlate" CornerRadius="22" Background="#FF111318">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <!-- 模糊封面氛围背景 -->
            <Grid x:Name="BgLayer" IsHitTestVisible="False">
                <Border x:Name="BgCover" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <ImageBrush x:Name="BgBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <BlurEffect Radius="80" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2A000000" Offset="0"/>
                            <GradientStop Color="#8C000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <Border CornerRadius="22" BorderThickness="1" BorderBrush="#24FFFFFF" IsHitTestVisible="False"/>

            <Grid Margin="18,18,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 封面 -->
                    <Grid Width="124" Height="124" VerticalAlignment="Top">
                        <Border CornerRadius="14" Background="#55000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.55" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#34466E" Offset="0"/>
                                    <GradientStop Color="#4E3A6E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Opacity="0.55"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="CoverBorder" CornerRadius="14" Opacity="0">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#1CFFFFFF"/>
                    </Grid>

                    <!-- 文字 + 进度 + 控制 -->
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <local:MarqueeText x:Name="TitleText" TextElement.FontSize="19" TextElement.FontWeight="SemiBold"
                                           Text="没有正在播放的媒体" Margin="0,0,22,0"/>
                        <Grid Grid.Row="1" Margin="0,3,0,0" Opacity="0.82">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ArtistIcon" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Opacity="0.75" VerticalAlignment="Center" Margin="0,1,6,0" Visibility="Collapsed"/>
                            <local:MarqueeText x:Name="ArtistText" Grid.Column="1" TextElement.FontSize="13.5"
                                               Text="在任意播放器里放点音乐吧"/>
                        </Grid>
                        <TextBlock x:Name="SubText" Grid.Row="2" FontSize="11.5" Opacity="0.5" TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"/>

                        <Grid x:Name="SeekArea" Grid.Row="4" Height="14" Background="Transparent"
                              MouseLeftButtonDown="Seek_MouseDown">
                            <Border x:Name="Track" Height="4" CornerRadius="2" Background="#30FFFFFF" VerticalAlignment="Center"/>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,1,0,-4">
                            <TextBlock x:Name="PosText" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" Text="0:00"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="上一首"/>
                                <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}" Content="&#xE768;" Click="Play_Click" Margin="8,0"/>
                                <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="下一首"/>
                            </StackPanel>
                            <TextBlock x:Name="DurText" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="0:00"/>
                        </Grid>
                    </Grid>
                </Grid>

                <local:SpectrumView x:Name="Spectrum" Grid.Row="1" Height="82" Margin="0,14,0,0"/>
            </Grid>

            <!-- 悬停时出现的隐藏按钮 -->
            <Button x:Name="HideBtn" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10"
                    Content="&#xE921;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    Opacity="0" Background="#22000000" Click="Hide_Click"
                    ToolTip="收起（Ctrl+Alt+M）"/>
        </Grid>

        <!-- 收起后的小圆片：旋转的封面 + 迷你频谱，单击展开 -->
        <Grid x:Name="Mini" Visibility="Collapsed" Height="48" Cursor="Hand" ToolTip="单击展开（Ctrl+Alt+M）">
            <Border x:Name="MiniPlate" CornerRadius="24" Background="#FF111318">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="24" BorderThickness="1" BorderBrush="#24FFFFFF" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Margin="7,7,16,7">
                <Grid Width="34" Height="34">
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#34466E" Offset="0"/>
                                <GradientStop Color="#4E3A6E" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="MiniCover" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="MiniCoverBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="MiniRotate"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="MiniHole" Width="7" Height="7" Fill="#FF111318" Stroke="#40FFFFFF" StrokeThickness="0.8" Opacity="0"/>
                    <Ellipse Stroke="#30FFFFFF" StrokeThickness="1"/>
                </Grid>
                <local:SpectrumView x:Name="MiniSpectrum" Width="36" Height="24" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
